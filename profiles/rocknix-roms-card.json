{
  "id": "rocknix-roms-card",
  "name": "ROCKNIX — ROMs card only",
  "cfw": "ROCKNIX",
  "deviceFamily": "any-dual-sd",
  "storageModes": [
    "roms_card_only"
  ],
  "romSchema": {
    "layout": "rocknix_roms_nested",
    "volumeLabel": "SHARE",
    "biosFolder": "bios",
    "systems": [
      {
        "id": "gba",
        "folder": "gba",
        "extensions": [
          ".gba",
          ".zip"
        ],
        "datNamePattern": "^Nintendo - Game Boy Advance"
      },
      {
        "id": "snes",
        "folder": "snes",
        "extensions": [
          ".sfc",
          ".smc",
          ".zip"
        ],
        "datNamePattern": "^Nintendo - Super Nintendo"
      },
      {
        "id": "nes",
        "folder": "nes",
        "extensions": [
          ".nes",
          ".zip"
        ],
        "datNamePattern": "^Nintendo - Entertainment System"
      },
      {
        "id": "megadrive",
        "folder": "megadrive",
        "extensions": [
          ".md",
          ".bin",
          ".zip"
        ],
        "datNamePattern": "^Sega - Mega Drive"
      },
      {
        "id": "psx",
        "folder": "psx",
        "extensions": [
          ".chd",
          ".cue",
          ".pbp"
        ],
        "datNamePattern": "^Sony - PlayStation"
      }
    ]
  },
  "version": 2
}
